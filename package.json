{
  "name": "henna-contract-app",
  "version": "0.1.0",
  "description": "Henna business contract manager",
  "main": "dist/main/electron/main.js",
  "author": "Taher Akolawala",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "package": "npm run build && electron-builder --win --x64",
    "android:sync": "npm run build:renderer && cap sync android",
    "android:build": "npm run android:sync && cd android && .\\gradlew.bat assembleDebug",
    "android:install": "npm run android:sync && cd android && .\\gradlew.bat installDebug"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@types/pdfmake": "^0.3.3",
    "pdfmake": "^0.3.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.tampabayhenna.contracts",
    "productName": "Henna Contracts",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron@30.5.1": true,
    "esbuild@0.21.5": true,
    "sharp@0.32.6": true
  }
}
